# Copy this file to .env.local and fill in the values from your Firebase project settings.
# These are safe to expose in the browser (Firebase security comes from database rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-only. Set these in Vercel > Project > Settings > Environment Variables.
# Never prefix them with VITE_, or they will be shipped to the browser.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL_SMART=claude-sonnet-5-5
# Optional: a passphrase your friends type once, so strangers can't spend your API credits.
APP_PASSPHRASE=
